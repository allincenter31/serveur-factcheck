{
  "manifest_version": 3,
  "name": "FactChecker AI",
  "version": "1.0",
  "description": "Vérifie la fiabilité des textes et images sur le web.",
  "permissions": [
    "activeTab",
    "scripting"
  ],
  "host_permissions": [
    "<all_urls>"
  ],
  "action": {
    "default_popup": "popup.html"
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["content.js"]
    }
  ]
}